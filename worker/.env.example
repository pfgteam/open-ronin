# Supabase (service role — bypasses RLS; the worker is the only writer of results)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic (the runtime's model)
ANTHROPIC_API_KEY=sk-ant-...

# Directory containing the skills, one folder per skill with a SKILL.md inside.
# The worker exposes them to the Agent SDK by pointing its cwd at a workspace
# whose .claude/skills symlinks/copies this directory.
SKILLS_DIR=./skills

# Tool credentials the skills need (held by the RUNTIME, never by the model)
AIRTABLE_API_KEY=pat...

# Identity string written to skill_runs.runtime for observability
RUNTIME_NAME=agent-sdk-worker-v1
