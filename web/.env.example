# web/.env.example
# Copy to web/.env.local (gitignored) and fill in. Every variable is listed in
# docs/ENV.md with what needs it. Only the "Required" block is needed to boot;
# everything else turns on one integration and can stay blank.

# --- Required -----------------------------------------------------------------
# Supabase project (local: `supabase status` prints these after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is served (used in emails, OAuth redirects, sign-in links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# org.allowed_email_domains from open-ronin.config.yaml, comma separated.
# The setup wizard stores the same list in the database (sign-up gate);
# this copy is what server code reads without a DB round trip.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=example.com

# Shown before the database is reachable (falls back to "Open Ronin")
NEXT_PUBLIC_ORG_NAME=

# Machine callers: Vercel Cron and ingest webhooks send these as Bearer tokens.
# Generate each with: openssl rand -hex 32
CRON_SECRET=
INGEST_API_KEY=

# Optional path to open-ronin.config.yaml for /setup (default: repo root)
OPEN_RONIN_CONFIG=

# --- Email (sign-in links, invites, notifications) ------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Google sign-in, Calendar, Sheets ---------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
METRICS_SPREADSHEET_ID=

# --- AI providers (the content studio, sales assistant, agents) --------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Media generation (optional, any subset)
IDEOGRAM_API_KEY=
STABILITY_API_KEY=
BFL_API_KEY=
RECRAFT_API_KEY=
LEONARDO_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
LUMA_API_KEY=
SYNTHESIA_API_KEY=
ELEVENLABS_API_KEY=
SUNO_API_KEY=
OPUSCLIP_API_KEY=
DESCRIPT_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
METRICOOL_API_KEY=
# Optional external call classifier (URL + bearer key)
CLASSIFIER_AI_URL=
CLASSIFIER_AI_KEY=

# --- CRM: GoHighLevel OAuth --------------------------------------------------------
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3000/api/ghl/callback
GHL_API_BASE=
GHL_AUTHORIZE_URL=
GHL_SCOPES=
# 64 hex chars (openssl rand -hex 32); also encrypts Google refresh tokens
GHL_TOKEN_ENC_KEY=

# --- Airtable (optional legacy mirror; native tables need none of this) -------------
AIRTABLE_PAT=
AIRTABLE_API_KEY=
AIRTABLE_WORKSPACE_ID=
AIRTABLE_OPPS_TABLE=
AIRTABLE_OPPS_CLIENTS_TABLE=
# One base id per AIRTABLE_BASE_<KEY> in web/src/lib/data/index.ts, e.g.
AIRTABLE_BASE_CLIENT_CENTRAL=
AIRTABLE_BASE_CLIENT_MEDIA=

# --- Scrapers, comms bridges, meetings -----------------------------------------------
APIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Public forms (Cloudflare Turnstile) and proof analytics -------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# random string; hashes visitor IPs in proof_events
PROOF_EVENT_SALT=

# --- Admin › Dev dashboard (read-only tokens, optional) ------------------------------
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
N8N_API_URL=
N8N_API_KEY=
SENTRY_DSN=
